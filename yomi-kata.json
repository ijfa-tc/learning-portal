  "loan": {"ja": "インドネシア語の ことば（kopi・taksi・masker など）に つられて います。日本語の カタカナ語は ちがいます。", "id": "Terpengaruh kata serapan bahasa Indonesia (kopi, taksi, masker, dll.). Katakana Jepang berbeda."},
  "long": {"ja": "のばす 音（ー）に 気を つけましょう。", "id": "Perhatikan bunyi panjang (ー)."},
  "tsu": {"ja": "小さい「ッ」に 気を つけましょう（bed ベッド、cup カップ）。", "id": "Perhatikan ッ kecil: bed → ベッド, cup → カップ."},
  "daku": {"ja": "「゛」に 気を つけましょう（bed は ベッド、bag は バッグ）。", "id": "Perhatikan tanda ゛: bed → ベッド (bukan ベット), bag → バッグ (bukan バック)."},
  "vowel": {"ja": "日本語では、ことばの 終わりの 音に 母音（ウ・オ など）を つけます（milk ミルク、desk デスク）。", "id": "Dalam bahasa Jepang, konsonan di akhir kata diberi vokal: milk → ミルク, desk → デスク."},
  "vfp": {"ja": "v は「バ・ビ・ブ・ベ・ボ」に なります（video ビデオ）。", "id": "Huruf v menjadi バ行 (ba, bi, bu, be, bo): video → ビデオ, bukan フィデオ."},
  "small": {"ja": "小さい 字（ャ・ュ・ョ・ィ など）に 気を つけましょう。", "id": "Perhatikan huruf kecil (ャ, ュ, ョ, ィ, dll.)."},
  "short": {"ja": "日本語では 長い ことばを 短く して 言います。", "id": "Dalam bahasa Jepang, kata yang panjang sering disingkat."},
  "spec": {"ja": "この 言い方は しません。そのまま おぼえましょう。", "id": "Kata ini tidak dipakai. Hafalkan bentuk yang benar."},
  "name": {"ja": "人や チームの 名前は、その国の ことばの 音から カタカナに します（Ronaldo → ロナウド、Real → レアル）。", "id": "Nama orang atau klub ditulis mengikuti bunyi bahasa aslinya: Ronaldo → ロナウド (Portugis), Real → レアル (Spanyol)."},
